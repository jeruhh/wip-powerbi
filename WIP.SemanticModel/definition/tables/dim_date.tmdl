		sortByColumn: 'Month-Year Sort'

		annotation SummarizationSetBy = Automatic

	column 'Date Filter' =
			
			VAR StartFY = 25
			VAR CurrentFY =
			    YEAR(TODAY()) + IF(MONTH(TODAY()) >= 7, 1, 0) - 2000
			    // Adjust ">=7" if your fiscal year starts in a different month
			
			VAR EndFY = CurrentFY + 1
			
			VAR RowFY =
			    VALUE(RIGHT('dim_date'[Fiscal Year], 2))
			
			RETURN
			    RowFY >= StartFY && RowFY <= EndFY
		formatString: """TRUE"";""TRUE"";""FALSE"""
		displayFolder: Calculated Columns
		lineageTag: 5d9ba88d-a8a1-447c-b9f6-4f68771ce0bf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Week
		displayFolder: Columns
		lineageTag: e07f889b-3e02-4a7b-9869-e3f478f094b4
		summarizeBy: none
		isNameInferred
		sourceColumn: [Week]

		annotation SummarizationSetBy = Automatic

	column 'Is Last 3 Months' = ```
			
			VAR TodayDate = TODAY()
			
			-- 1. Find the exact 1st day of the current month
			VAR StartCurrentMonth = DATE ( YEAR ( TodayDate ), MONTH ( TodayDate ), 1 )
			
			-- 2. Shift back 2 months to get the strictly anchored 1st day of the 3rd month
			VAR StartDate = EDATE ( StartCurrentMonth, -2 ) 
			
			-- 3. Find the last day of the current month
			VAR EndDate = EOMONTH ( TodayDate, 0 )
			
			RETURN
			    IF ( dim_date[Date] >= StartDate && dim_date[Date] <= EndDate, 1, 0 )
			```
		formatString: 0
		displayFolder: Calculated Columns
		lineageTag: d2b119fe-9e24-4cc2-911b-a3e73a6181a2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	hierarchy 'Date Hierarchy'
		lineageTag: fe9a9595-54fe-479c-9f69-184ccb514439

		level 'Fiscal Year'
			lineageTag: e1646700-325c-481e-b190-6a462f50d667
			column: 'Fiscal Year'

		level 'Month Name'
			lineageTag: b954a3ff-1c55-4564-bcec-4fdc8ae626af
			column: 'Month Name'

		level 'Day Number'
			lineageTag: dcc9c6bc-90dc-4e03-956c-224524be6ce7
			column: 'Day Number'

	partition dim_date = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    FILTER (
				        CALENDARAUTO(),
				        [Date] >= DATE(2025,1,1)
				    ),
				
				    -- Standard Calendar Columns
				    "Year", YEAR ( [Date] ),
				    "Month Number", MONTH ( [Date] ),
				    "Month Name", FORMAT ( [Date], "MMM" ),
				    "Quarter", "Q" & FORMAT ( [Date], "Q" ),
				    "Month-Year Sort", FORMAT ( [Date], "yyyyMM" ),
				    "Day Name", FORMAT ( [Date], "dddd" ),
				    "Day Number", DAY ( [Date] ),
				
				    -- Fiscal Year (July to June)
				    "Fiscal Year",
				        VAR FY = YEAR ( EDATE ( [Date], 6 ) )
				        RETURN "FY" & RIGHT ( FY, 2 ),
				
				    -- Fiscal Month Sort (July = 1)
				    "Fiscal Year Month Sort",
				        VAR M = MONTH ( [Date] )
				        RETURN IF ( M >= 7, M - 6, M + 6 ),
				
				    -- Month Tags
				    "Month Tag",
				        VAR TodayDate = TODAY ()
				        VAR StartCurrentMonth =
				            DATE ( YEAR ( TodayDate ), MONTH ( TodayDate ), 1 )
				        VAR StartPreviousMonth =
				            EDATE ( StartCurrentMonth, -1 )
				        VAR StartRowMonth =
				            DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 )
				        RETURN
				            SWITCH (
				                TRUE (),
				                StartRowMonth = StartCurrentMonth, "Current Month",
				                StartRowMonth = StartPreviousMonth, "Previous Month"
				            ),
				
				    -- Display Column
				    "Month-Year", FORMAT ( [Date], "MMM" ) & YEAR ( [Date] ),
				
				    -- Month-based Week (resets every month, fixed 7-day groups)
				    "Week",
				        VAR DayOfMonth = DAY([Date])
				        VAR WeekNum = INT((DayOfMonth - 1) / 7) + 1
				        RETURN "Week " & WeekNum
				)

	annotation PBI_Id = ac9da9e351b44da6bf69b60a91d21991

