				    Typed = Table.TransformColumnTypes(ParsedDate, {
				        {"Name of Clients (TC Reference)", type text}, {"Xero Name", type text},
				        {"Business Stream", type text}, {"Date", type datetime}, {"tcref_bs_id", type text},
				        {"Rates", type number}, {"Forecasted Revenue", type number},
				        {"Standard Hours", type number}, {"Xero Revenue", type number}
				    })
				in
				    Typed

