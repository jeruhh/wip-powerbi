	partition fact_client_data = m
		mode: import
		queryGroup: Fact
		source =
				let
				    Source = Excel.Workbook(File.Contents(SyntheticDataPath), null, true),
				    Data = Source{[Item="fact_client_data",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Data, [PromoteAllScalars=true]),
				    ParsedDate = Table.TransformColumns(Promoted, {
				        {"Date", each try DateTime.From(Date.FromText(Text.From(_), [Format="M/d/yyyy", Culture="en-US"])) otherwise null}
